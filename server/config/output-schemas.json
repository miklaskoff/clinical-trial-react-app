{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "clinical-trial-parser-output-schemas",
  "version": "1.0.0",
  "description": "Output schemas for each cluster type in clinical trial criteria parser",
  
  "commonFields": {
    "required": ["id", "nct_id", "raw_text", "CRITERION_TYPE", "EXCLUSION_STRENGTH", "confidence", "parsing_status"],
    "optional": ["_thought_process", "LOGICAL_OPERATOR", "NESTED_CONDITION", "unfamiliar_term_flag", "AMBIGUITY_FLAG", "REQUIRES_CLINICAL_JUDGMENT", "SUBJECTIVE_ESTIMATE", "original"]
  },
  
  "fieldTypes": {
    "id": "string",
    "nct_id": "string",
    "raw_text": "string",
    "_thought_process": "string",
    "CRITERION_TYPE": {
      "type": "string",
      "enum": ["inclusion", "exclusion"]
    },
    "EXCLUSION_STRENGTH": {
      "type": "string",
      "enum": ["mandatory_exclude", "conditional_exclude", "mandatory_include", "conditional_include"]
    },
    "SUBJECTIVE_ESTIMATE": "boolean",
    "confidence": "number",
    "parsing_status": {
      "type": "string",
      "enum": ["complete", "pending_admin_review", "error"]
    },
    "unfamiliar_term_flag": "boolean",
    "AMBIGUITY_FLAG": "boolean",
    "REQUIRES_CLINICAL_JUDGMENT": "boolean",
    "LOGICAL_OPERATOR": {
      "type": ["string", "null"],
      "enum": ["AND", "OR", null]
    },
    "CONDITION_TYPE": "array",
    "CONDITION_PATTERN": "array",
    "SEVERITY": "array",
    "ANATOMICAL_LOCATION": "array",
    "PSORIASIS_VARIANT": "array",
    "AGE_MIN": ["integer", "null"],
    "AGE_MAX": ["integer", "null"],
    "AGE_UNIT": "string",
    "BMI_MIN": ["number", "null"],
    "BMI_MAX": ["number", "null"],
    "WEIGHT_MIN": ["number", "null"],
    "WEIGHT_MAX": ["number", "null"],
    "WEIGHT_UNIT": "string",
    "MEASUREMENTS": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "parameter": "string",
          "value": "number",
          "min": "number",
          "max": "number",
          "comparison": "string",
          "unit": "string",
          "gender": "string",
          "unfamiliar_term_flag": "boolean",
          "confidence": "number"
        }
      }
    },
    "TIMEFRAME": {
      "type": ["object", "null"],
      "properties": {
        "relation": "string",
        "amount": "number",
        "unit": "string",
        "reference": "string"
      }
    },
    "EXCEPTION_CONDITION": {
      "type": ["object", "null"],
      "properties": {
        "excluded_types": "array",
        "condition": "string",
        "anatomical_location": "array",
        "makes_eligible": "boolean",
        "additional_requirements": "array"
      }
    },
    "NEGATION_DETECTED": {
      "type": ["object", "null"],
      "properties": {
        "is_negated": "boolean",
        "negated_term": "string",
        "context": "string"
      }
    },
    "NESTED_CONDITION": {
      "type": ["object", "null"],
      "properties": {
        "main_condition": "object",
        "nested_operator": "string",
        "nested_count": "integer",
        "nested_items": "array",
        "nested_logical_operator": "string"
      },
      "requiredSubFields": ["main_condition", "nested_operator", "nested_items"]
    }
  },
  
  "clusters": {
    "AGE": {
      "required": ["id", "nct_id", "raw_text", "CRITERION_TYPE", "EXCLUSION_STRENGTH", "confidence", "parsing_status"],
      "optional": ["_thought_process", "AGE_MIN", "AGE_MAX", "AGE_UNIT", "MEASUREMENTS", "LOGICAL_OPERATOR", "NESTED_CONDITION", "SUBJECTIVE_ESTIMATE", "unfamiliar_term_flag", "AMBIGUITY_FLAG", "original"]
    },
    "BMI": {
      "required": ["id", "nct_id", "raw_text", "CRITERION_TYPE", "EXCLUSION_STRENGTH", "confidence", "parsing_status"],
      "optional": ["_thought_process", "BMI_MIN", "BMI_MAX", "WEIGHT_MIN", "WEIGHT_MAX", "WEIGHT_UNIT", "MEASUREMENTS", "LOGICAL_OPERATOR", "NESTED_CONDITION", "SUBJECTIVE_ESTIMATE", "unfamiliar_term_flag", "AMBIGUITY_FLAG", "original"]
    },
    "SEV": {
      "required": ["id", "nct_id", "raw_text", "CRITERION_TYPE", "EXCLUSION_STRENGTH", "confidence", "parsing_status"],
      "optional": ["_thought_process", "SEVERITY", "CONDITION_PATTERN", "MEASUREMENTS", "ANATOMICAL_LOCATION", "LOGICAL_OPERATOR", "NESTED_CONDITION", "SUBJECTIVE_ESTIMATE", "unfamiliar_term_flag", "AMBIGUITY_FLAG", "original"]
    },
    "AAO": {
      "required": ["id", "nct_id", "raw_text", "CRITERION_TYPE", "EXCLUSION_STRENGTH", "confidence", "parsing_status"],
      "optional": ["_thought_process", "ANATOMICAL_LOCATION", "MEASUREMENTS", "LOGICAL_OPERATOR", "NESTED_CONDITION", "SUBJECTIVE_ESTIMATE", "unfamiliar_term_flag", "AMBIGUITY_FLAG", "original"]
    },
    "NPV": {
      "required": ["id", "nct_id", "raw_text", "CRITERION_TYPE", "EXCLUSION_STRENGTH", "confidence", "parsing_status"],
      "optional": ["_thought_process", "PSORIASIS_VARIANT", "CONDITION_TYPE", "NEGATION_DETECTED", "LOGICAL_OPERATOR", "NESTED_CONDITION", "SUBJECTIVE_ESTIMATE", "unfamiliar_term_flag", "AMBIGUITY_FLAG", "original"]
    },
    "BIO": {
      "required": ["id", "nct_id", "raw_text", "CRITERION_TYPE", "EXCLUSION_STRENGTH", "confidence", "parsing_status"],
      "optional": ["_thought_process", "CONDITION_TYPE", "CONDITION_PATTERN", "MEASUREMENTS", "LOGICAL_OPERATOR", "NESTED_CONDITION", "SUBJECTIVE_ESTIMATE", "unfamiliar_term_flag", "AMBIGUITY_FLAG", "original"]
    },
    "CMB": {
      "required": ["id", "nct_id", "raw_text", "CRITERION_TYPE", "EXCLUSION_STRENGTH", "CONDITION_TYPE", "confidence", "parsing_status"],
      "optional": ["_thought_process", "CONDITION_PATTERN", "SEVERITY", "MEASUREMENTS", "ANATOMICAL_LOCATION", "TIMEFRAME", "EXCEPTION_CONDITION", "NEGATION_DETECTED", "NESTED_CONDITION", "LOGICAL_OPERATOR", "REQUIRES_CLINICAL_JUDGMENT", "SUBJECTIVE_ESTIMATE", "unfamiliar_term_flag", "AMBIGUITY_FLAG", "original"]
    },
    "CPD": {
      "required": ["id", "nct_id", "raw_text", "CRITERION_TYPE", "EXCLUSION_STRENGTH", "confidence", "parsing_status"],
      "optional": ["_thought_process", "CONDITION_TYPE", "CONDITION_PATTERN", "TIMEFRAME", "LOGICAL_OPERATOR", "NESTED_CONDITION", "SUBJECTIVE_ESTIMATE", "unfamiliar_term_flag", "AMBIGUITY_FLAG", "original"]
    },
    "FLR": {
      "required": ["id", "nct_id", "raw_text", "CRITERION_TYPE", "EXCLUSION_STRENGTH", "confidence", "parsing_status"],
      "optional": ["_thought_process", "CONDITION_TYPE", "TIMEFRAME", "TREATMENT_HISTORY", "LOGICAL_OPERATOR", "NESTED_CONDITION", "SUBJECTIVE_ESTIMATE", "unfamiliar_term_flag", "AMBIGUITY_FLAG", "original"]
    },
    "AIC": {
      "required": ["id", "nct_id", "raw_text", "CRITERION_TYPE", "EXCLUSION_STRENGTH", "confidence", "parsing_status"],
      "optional": ["_thought_process", "CONDITION_TYPE", "TIMEFRAME", "NEGATION_DETECTED", "LOGICAL_OPERATOR", "NESTED_CONDITION", "SUBJECTIVE_ESTIMATE", "unfamiliar_term_flag", "AMBIGUITY_FLAG", "original"]
    },
    "PTH": {
      "required": ["id", "nct_id", "raw_text", "CRITERION_TYPE", "EXCLUSION_STRENGTH", "confidence", "parsing_status"],
      "optional": ["_thought_process", "CONDITION_TYPE", "CONDITION_PATTERN", "TIMEFRAME", "EXCEPTION_CONDITION", "LOGICAL_OPERATOR", "NESTED_CONDITION", "SUBJECTIVE_ESTIMATE", "unfamiliar_term_flag", "AMBIGUITY_FLAG", "original"]
    }
  },
  
  "defaults": {
    "confidence": 1.0,
    "parsing_status": "complete",
    "unfamiliar_term_flag": false,
    "AMBIGUITY_FLAG": false,
    "REQUIRES_CLINICAL_JUDGMENT": false,
    "SUBJECTIVE_ESTIMATE": false,
    "CONDITION_TYPE": [],
    "CONDITION_PATTERN": [],
    "SEVERITY": [],
    "ANATOMICAL_LOCATION": []
  },
  
  "inferenceRules": {
    "CRITERION_TYPE": {
      "from": "original.criterion_type",
      "fallback": "exclusion"
    },
    "EXCLUSION_STRENGTH": {
      "fromCriterionType": {
        "exclusion": "mandatory_exclude",
        "inclusion": "mandatory_include"
      }
    },
    "SUBJECTIVE_ESTIMATE": {
      "from": "REQUIRES_CLINICAL_JUDGMENT",
      "fallback": false
    }
  }
}
